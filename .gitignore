vr-client-unity/Vellum Rift/Library/ArtifactDB
vr-client-unity/Vellum Rift/Library/ArtifactDB-lock
vr-client-unity/Vellum Rift/Library/SourceAssetDB
vr-client-unity/Vellum Rift/Library/SourceAssetDB-lock
vr-client-unity/Vellum Rift/Library/ilpp.pid

# Rider / Visual Studio caches
vr-client-unity/Vellum Rift/.vs/
vr-client-unity/Vellum Rift/*.suo
vr-client-unity/Vellum Rift/*.userprefs
vr-client-unity/Vellum Rift/*.pidb