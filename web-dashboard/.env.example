# Backend the dashboard calls (optional helpers for later slices)
# VITE_API_BASE_URL=http://localhost:4000

# Bluekey SSO (required for real sign-in)
# VITE_BLUEKEY_SOFTWARE_ID=your-app-uuid-here
# VITE_BLUEKEY_PORTAL_URL=https://iis.memphis.edu/static/bluekey/
# VITE_BLUEKEY_ORIGIN=https://iis.memphis.edu

# Public dashboard URL registered as Bluekey redirectUri (production IIS path)
# VITE_DASHBOARD_PUBLIC_URL=https://iis.memphis.edu/static/vellum-dashboard/

# Custom protocol for Launch desktop app (Electron launcher registers vellumrift://)
# VITE_DESKTOP_LAUNCH_PROTOCOL=vellumrift

# Shared / hosted dashboard: require Bluekey (hides local-dev skip)
# VITE_AUTH_REQUIRED=true

# Museum walk-up: optional default Space for “Join museum exhibit” on the login page (#180).
# Guests still need kiosk enabled on that Space. Prefer QR/kiosk links on signage.
# VITE_MUSEUM_KIOSK_SPACE_ID=

# Optional looping VR plate behind post-login home (muted, low-latency WebM preferred)
# Place file at web-dashboard/public/home-bg.webm OR set:
# VITE_HOME_BG_VIDEO_URL=https://example.com/vellum-rift-home-loop.webm

# Unity WebGL build base URL for Enter → “Enter 3D Experience”
# (query params session, playerName, isHost, backendUrl are appended)
# VITE_WEBGL_BASE_URL=https://iis.memphis.edu/vellumrift/
