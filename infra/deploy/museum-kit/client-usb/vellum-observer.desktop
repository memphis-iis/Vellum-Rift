[Desktop Entry]
Type=Application
Name=Vellum Wall Observer
Comment=Open museum dashboard for Observer / wall display
Exec=bash -lc '[[ -f /opt/vellum-client/campus.env ]] && set -a && . /opt/vellum-client/campus.env && set +a; /opt/vellum-client/join-exhibit.sh observer'
Icon=video-display
Terminal=false
Categories=Network;
X-GNOME-Autostart-enabled=false
