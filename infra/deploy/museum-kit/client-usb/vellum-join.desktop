[Desktop Entry]
Type=Application
Name=Join Vellum Exhibit
Comment=Open museum kiosk (LAN discover or campus.env pinned URL)
Exec=bash -lc '[[ -f /opt/vellum-client/campus.env ]] && set -a && . /opt/vellum-client/campus.env && set +a; /opt/vellum-client/join-exhibit.sh join'
Icon=applications-internet
Terminal=false
Categories=Network;
X-GNOME-Autostart-enabled=true
