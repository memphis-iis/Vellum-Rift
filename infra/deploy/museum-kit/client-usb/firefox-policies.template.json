{
  "policies": {
    "_comment": "Template only — join-exhibit.sh runs write-firefox-policies.sh. LAN = host-wide http/https; campus HTTPS = path-scoped vellum-dashboard / vellumrift / apis/vellumrift.",
    "BlockAboutConfig": true,
    "DisableFirefoxAccounts": true,
    "DisablePrivateBrowsing": true,
    "Homepage": {
      "URL": "https://iis.memphis.edu/static/vellum-dashboard/?session=SESSION_ID&kiosk=1",
      "Locked": true,
      "StartPage": "homepage"
    },
    "WebsiteFilter": {
      "Block": ["<all_urls>"],
      "Exceptions": [
        "https://iis.memphis.edu/static/vellum-dashboard/*",
        "https://iis.memphis.edu/vellumrift/*",
        "https://iis.memphis.edu/apis/vellumrift/*"
      ]
    }
  }
}
