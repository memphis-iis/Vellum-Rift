# Campus (iis.memphis.edu) client USB — copy to campus.env on the stick.
# Skips kit Wi‑Fi + UDP discover; pin kiosk URL; firewall allowlists iis only.

VELLUM_CONNECT_WIFI=0
VELLUM_SKIP_DISCOVER=1
VELLUM_KIOSK=1
VELLUM_KIOSK_FIREWALL=1
VELLUM_FIREFOX_PATH_SCOPE=1

# Replace SESSION_ID with today's Event Space id (host Lobby → kiosk link).
VELLUM_MUSEUM_URL=https://iis.memphis.edu/static/vellum-dashboard/?session=SESSION_ID&kiosk=1
