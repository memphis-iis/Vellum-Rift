# Museum-kit template — show-day IP is written to runtime.env by start-museum-kit.sh.
# Do NOT use on the Memphis / IIS host.

PORT=4000
NODE_ENV=production
DISCOVER_PORT=41234
EDGE_PORT=80

# AUTH_REQUIRED unset/false — stub / local-developer hosts.
KIOSK_JWT_SECRET=change-me-museum-kit-kiosk-secret
KIOSK_TOKEN_TTL_SEC=3600
KIOSK_RATE_LIMIT=60
KIOSK_RATE_WINDOW_MS=300000

CHAT_ENABLED=false
VITE_CHAT_ENABLED=false
VITE_AUTH_REQUIRED=false
# Relative / same-origin (edge :80)
VITE_API_BASE_URL=
VITE_WEBGL_BASE_URL=/webgl/
# VITE_MUSEUM_KIOSK_SPACE_ID=

S3_REGION=us-east-1
S3_BUCKET_NAME=vellumrift-lan
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minioadmin

POSTGRES_DB=vellum_rift
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

REALTIME_JWT_SECRET=museum-kit-realtime-secret
# WEBGL_DIST=../lan-party/webgl
