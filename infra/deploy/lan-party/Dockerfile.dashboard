# LAN party dashboard — build Vite static assets with baked VITE_* vars, serve via nginx.
# Build context: repository root (see docker-compose.yml).
# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY backend/package.json ./backend/
COPY webrtc-sfu/package.json ./webrtc-sfu/
COPY web-dashboard/package.json ./web-dashboard/
COPY launcher/package.json ./launcher/

RUN pnpm install --frozen-lockfile --filter=@vellum-rift/web-dashboard...

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_WEBGL_BASE_URL
ARG VITE_AUTH_REQUIRED=false
ARG VITE_CHAT_ENABLED=false
ARG VITE_MUSEUM_KIOSK_SPACE_ID=

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_WEBGL_BASE_URL=${VITE_WEBGL_BASE_URL} \
    VITE_AUTH_REQUIRED=${VITE_AUTH_REQUIRED} \
    VITE_CHAT_ENABLED=${VITE_CHAT_ENABLED} \
    VITE_MUSEUM_KIOSK_SPACE_ID=${VITE_MUSEUM_KIOSK_SPACE_ID}

RUN pnpm --filter @vellum-rift/web-dashboard build

# ---------------------------------------------------------------------------
FROM nginx:alpine AS runner
WORKDIR /usr/share/nginx/html

COPY --from=builder /app/web-dashboard/dist .

RUN rm /etc/nginx/conf.d/default.conf && cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
