# Offline LAN party profile — copy to .env and replace <SERVER_LAN_IP>.
# Do NOT use this file on the Memphis / IIS host.
#
# Auth: leave AUTH_REQUIRED unset/false so hosts use stub / local-developer
# paths. Guests still mint kiosk JWTs when the host enables kiosk on a Space.
# Chat: off for LAN parties (IIS leaves these unset so chat stays on).
# SFU / ICE_SERVERS: unused — Unity multiplayer is HTTP game-state polling.

PORT=4000
NODE_ENV=production

# Replace with the server’s LAN address reachable by laptops and Quests.
# Prefer ./start-with-dns.sh — detects host IPv4 → .env.runtime (SERVER_LAN_IP,
# DNSMASQ_BIND_IP, DASHBOARD_PUBLIC_URL, VITE_WEBGL_BASE_URL, empty VITE_API_BASE_URL,
# S3_ENDPOINT) and rebakes web-dashboard when IP changes. Statics below are fallbacks.
SERVER_LAN_IP=192.168.1.50
# Optional override; start-with-dns.sh sets this to match SERVER_LAN_IP.
# DNSMASQ_BIND_IP=

DATABASE_URL=postgres://postgres:postgres@postgres:5432/vellum_rift

# AUTH_REQUIRED unset/false — no Bluekey IdP on an air-gapped router.
# AUTH_REQUIRED=true

KIOSK_JWT_SECRET=change-me-lan-party-kiosk-secret
KIOSK_TOKEN_TTL_SEC=3600
KIOSK_RATE_LIMIT=60
KIOSK_RATE_WINDOW_MS=300000

CHAT_ENABLED=false
# Bake into the LAN dashboard build (see Vite section below):
# VITE_CHAT_ENABLED=false

# Dashboard public URL (matches web-dashboard compose publish port).
DASHBOARD_PUBLIC_URL=http://192.168.1.50:5173
DASHBOARD_PORT=5173
# Host :80 for Quest connectivity checks when DNS sinkholes gstatic/etc to SERVER_LAN_IP.
DASHBOARD_HTTP_PORT=80

# WebGL static host (nginx volume — copy Unity `web build/` output into ./webgl).
WEBGL_PORT=8080
# WEBGL_DIST=./webgl

# MinIO — use the LAN IP if clients ever see presigned URLs; backend→MinIO
# inside compose can use http://minio:9000 instead.
S3_ENDPOINT=http://192.168.1.50:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=vellumrift-lan
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minioadmin

POSTGRES_DB=vellum_rift
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Dashboard build-time (Vite) — baked by compose Dockerfile.dashboard ---
# Empty = same-origin /api via nginx-dashboard.conf (LAN + Tailscale). Or set http://<LAN_IP>:4000
VITE_API_BASE_URL=
VITE_WEBGL_BASE_URL=http://192.168.1.50:8080/
VITE_AUTH_REQUIRED=false
VITE_CHAT_ENABLED=false
# VITE_MUSEUM_KIOSK_SPACE_ID=

# Realtime JWT kept for API compatibility; do not start webrtc-sfu for LAN parties.
REALTIME_JWT_SECRET=lan-party-realtime-secret
# SFU_PUBLIC_URL=http://192.168.1.50:4100
