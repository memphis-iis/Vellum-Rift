# Copy to .env on the box and set real secrets.
PORT=4000
NODE_ENV=production
DATABASE_URL=postgres://vellumrift:CHANGE_ME@hasura-postgres:5432/vellum_rift
AUTH_REQUIRED=true

# Bluekey SSO + app notification mail (#94 / bluekey#5)
BLUEKEY_SOFTWARE_ID=a1b2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d
BLUEKEY_PORTAL_URL=https://iis.memphis.edu/static/bluekey/
BLUEKEY_ORIGIN=https://iis.memphis.edu
BLUEKEY_INTROSPECT_URL=https://iis.memphis.edu/apis/bluekey/public/sso/introspect
BLUEKEY_API_BASE_URL=https://iis.memphis.edu/apis/bluekey
BLUEKEY_API_TOKEN=CHANGE_ME
DASHBOARD_PUBLIC_URL=https://iis.memphis.edu/static/vellum-dashboard

# MinIO (box minio container; the backend reaches it via the traefik_proxy gateway)
S3_ENDPOINT=http://172.31.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=vellumrift
S3_ACCESS_KEY_ID=vellumrift
S3_SECRET_ACCESS_KEY=CHANGE_ME
