# Copy to .env on the box and set real secrets.
PORT=4000
NODE_ENV=production
DATABASE_URL=postgres://vellumrift:CHANGE_ME@hasura-postgres:5432/vellum_rift
# Auth is a dev pass-through until Bluekey SSO is wired (see backend/.env.example).
AUTH_REQUIRED=false

# MinIO (box minio container; the backend reaches it via the traefik_proxy gateway)
S3_ENDPOINT=http://172.31.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=vellumrift
S3_ACCESS_KEY_ID=vellumrift
S3_SECRET_ACCESS_KEY=CHANGE_ME
