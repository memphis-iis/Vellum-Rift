PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vellum_rift

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=local-manuscript-cache
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minioadmin

RAW_ASSET_TTL_DAYS=30

STT_SERVICE_URL=http://localhost:10300
TTS_SERVICE_URL=http://localhost:10400

# Public dashboard URL used in invite / processing-complete emails (?session=)
# DASHBOARD_PUBLIC_URL=https://iis.memphis.edu/static/vellumrift/

# Bluekey SSO
# Local dev: leave AUTH_REQUIRED unset/false (stub user on protected routes).
# Shared / test / production hosts MUST set AUTH_REQUIRED=true.
# BLUEKEY_SOFTWARE_ID=a1b2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d
# AUTH_REQUIRED=true
# BLUEKEY_PORTAL_URL=https://iis.memphis.edu/static/bluekey/
# BLUEKEY_ORIGIN=https://iis.memphis.edu
# BLUEKEY_INTROSPECT_URL=https://iis.memphis.edu/apis/bluekey/public/sso/introspect

# Bluekey app notification mail (issue #94 / bluekey#5). Without token, invites are stored but email is skipped.
# BLUEKEY_API_BASE_URL=https://iis.memphis.edu/apis/bluekey
# BLUEKEY_API_TOKEN=

# Realtime / SFU signaling tokens (must match webrtc-sfu REALTIME_JWT_SECRET)
REALTIME_JWT_SECRET=local-dev-realtime-secret
SFU_PUBLIC_URL=http://localhost:4100
# REALTIME_TOKEN_TTL_SEC=300
JWT_ISSUER=vellum-rift-local
JWT_AUDIENCE=vellum-rift-clients

# Museum kiosk / public join (#145). Keep AUTH_REQUIRED=true; guests mint
# session-scoped JWTs via POST /api/kiosk/:sessionId/token when the host
# enables kiosk on that space.
# KIOSK_JWT_SECRET=change-me-in-production
# KIOSK_TOKEN_TTL_SEC=3600
# KIOSK_RATE_LIMIT=30
# KIOSK_RATE_WINDOW_MS=300000
